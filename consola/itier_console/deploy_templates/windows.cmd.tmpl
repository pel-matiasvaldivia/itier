@echo off
setlocal
title iTier - Instalador
rem ---------------------------------------------------------------------------
rem  iTier - instalador para equipos Windows del cliente "@@TENANT@@"
rem  Doble clic: pide permisos de administrador (UAC) una sola vez y despues
rem  instala todo en silencio, como servicios. No contiene secretos.
rem ---------------------------------------------------------------------------
fltmc >nul 2>&1
if %errorlevel% neq 0 (
  echo Solicitando permisos de administrador. Acepte el aviso de Windows...
  powershell -NoProfile -ExecutionPolicy Bypass -Command "Start-Process -FilePath '%~f0' -Verb RunAs"
  exit /b 0
)
echo Instalando iTier. No cierre esta ventana; se cierra sola al terminar...
powershell -NoProfile -ExecutionPolicy Bypass -Command "$s=[IO.File]::ReadAllText('%~f0'); $i=$s.LastIndexOf('#__ITIER_' + 'PS__'); & ([scriptblock]::Create($s.Substring($i)))"
set RC=%errorlevel%
if not "%RC%"=="0" (
  echo.
  echo La instalacion no pudo completarse ^(codigo %RC%^). Avise a su proveedor de soporte.
  pause
)
exit /b %RC%
#__ITIER_PS__
