#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
# iTier — instalador del appliance del cliente «@@TENANT@@»
# Generado por la consola de iTier. CONTIENE SECRETOS: no lo publiques ni lo
# guardes en repositorios. Ejecutar como root en el equipo del cliente:
#     sudo bash install.sh
# Deja el stack en /opt/itier y lo registra como servicio (itier.service).
# Es idempotente: se puede volver a correr para reparar o actualizar.
# ─────────────────────────────────────────────────────────────────────────────
set -euo pipefail

TENANT="@@TENANT@@"
URL_REPORTE="@@URL_REPORTE@@"
DIR="${ITIER_DIR:-/opt/itier}"
UNIT_DIR="${ITIER_UNIT_DIR:-/etc/systemd/system}"

info()  { printf '\033[1;34m[iTier]\033[0m %s\n' "$*"; }
aviso() { printf '\033[1;33m[iTier] AVISO:\033[0m %s\n' "$*" >&2; }

reportar() {  # reportar <ok|error> — le avisa a la consola cómo quedó (best-effort)
  [ -n "$URL_REPORTE" ] || return 0
  local ip_lan=""
  ip_lan="$(ip -4 route get 1.1.1.1 2>/dev/null | sed -n 's/.* src \([0-9.]*\).*/\1/p' | head -n1 || true)"
  curl -fsS -m 15 -X POST "$URL_REPORTE" \
    --data-urlencode "estado=$1" \
    --data-urlencode "host=$(hostname 2>/dev/null || echo desconocido)" \
    --data-urlencode "ip=$ip_lan" >/dev/null 2>&1 || true
}

fallar() {
  printf '\033[1;31m[iTier] ERROR:\033[0m %s\n' "$*" >&2
  reportar error
  exit 1
}

# ── 1. Verificaciones previas ────────────────────────────────────────────────
if [ "${ITIER_SKIP_CHECKS:-0}" != "1" ]; then
  [ "$(id -u)" -eq 0 ] || fallar "Ejecutá el instalador como root (sudo bash install.sh)."

  case "$(uname -m)" in
    x86_64|aarch64|arm64) ;;
    *) fallar "Arquitectura $(uname -m) no soportada (x86_64 o arm64)." ;;
  esac

  VIRT="$(systemd-detect-virt -c 2>/dev/null || true)"
  if [ "$VIRT" = "lxc" ]; then
    aviso "Este equipo es un contenedor LXC: Docker puede fallar al crear contenedores"
    aviso "(error de 'sysctl ... permission denied'). Si pasa, usá una VM o ajustá el LXC"
    aviso "en el host (ver README del cliente)."
  fi
fi

# ── 2. Docker ────────────────────────────────────────────────────────────────
if ! command -v docker >/dev/null 2>&1; then
  info "Docker no está instalado: lo instalo (get.docker.com)…"
  command -v curl >/dev/null 2>&1 || { apt-get update -qq && apt-get install -y -qq curl ca-certificates; }
  curl -fsSL https://get.docker.com | sh || fallar "No se pudo instalar Docker."
fi
docker compose version >/dev/null 2>&1 || fallar "Falta el plugin 'docker compose' (Docker Compose v2)."
if command -v systemctl >/dev/null 2>&1; then systemctl enable --now docker >/dev/null 2>&1 || true; fi

# ── 3. Archivos del stack (preconfigurados) ──────────────────────────────────
info "Escribiendo la configuración en $DIR…"
umask 077
mkdir -p "$DIR/enc"
chmod 700 "$DIR"
[ -f "$DIR/.env" ] && cp -p "$DIR/.env" "$DIR/.env.anterior"

cat > "$DIR/docker-compose.yml" <<'ITIER_EOF_COMPOSE'
@@COMPOSE@@
ITIER_EOF_COMPOSE

cat > "$DIR/.env" <<'ITIER_EOF_ENV'
@@ENV@@
ITIER_EOF_ENV
chmod 600 "$DIR/.env"

# La PSK la lee el usuario no-root del contenedor del proxy: el archivo va 644
# dentro de un directorio padre 700 (solo root llega hasta él en el host).
printf '%s' '@@PSK@@' > "$DIR/enc/proxy.psk"
chmod 755 "$DIR/enc"
chmod 644 "$DIR/enc/proxy.psk"

# ── 4. Servicio ──────────────────────────────────────────────────────────────
cd "$DIR"
info "Descargando imágenes…"
docker compose pull || fallar "No se pudieron descargar las imágenes (¿hay salida a internet?)."

if command -v systemctl >/dev/null 2>&1 && [ -d "$UNIT_DIR" ]; then
  cat > "$UNIT_DIR/itier.service" <<ITIER_EOF_UNIT
[Unit]
Description=iTier — appliance del cliente ($TENANT)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=$DIR
ExecStart=/usr/bin/env docker compose up -d --remove-orphans
ExecStop=/usr/bin/env docker compose stop
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
ITIER_EOF_UNIT
  chmod 644 "$UNIT_DIR/itier.service"
  systemctl daemon-reload
  systemctl enable itier.service >/dev/null 2>&1 || true
  info "Levantando el servicio itier.service…"
  systemctl restart itier.service || fallar "El servicio no arrancó. Revisá: journalctl -u itier.service -n 50"
else
  info "Sin systemd: levanto el stack directo (reinicia solo por la política de Docker)…"
  docker compose up -d --remove-orphans || fallar "El stack no arrancó. Revisá: docker compose logs"
fi

# ── 5. Verificación y aviso a la consola ─────────────────────────────────────
sleep "${ITIER_ESPERA:-8}"
docker compose ps || true
CAIDOS="$(docker compose ps --all --format '{{.Service}} {{.State}}' 2>/dev/null | awk '$2!="running"{print $1}' | tr '\n' ' ')"
if [ -n "${CAIDOS// /}" ]; then
  fallar "Servicios que no quedaron corriendo: ${CAIDOS}— revisá: cd $DIR && docker compose logs"
fi

reportar ok
info "Listo. El appliance de «$TENANT» quedó instalado en $DIR como servicio (itier.service)."
info "Estado:  systemctl status itier  ·  Logs:  cd $DIR && docker compose logs -f"
