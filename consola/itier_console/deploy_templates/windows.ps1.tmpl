#Requires -RunAsAdministrator
<#
  iTier - instalador para equipos Windows del cliente "@@TENANT@@"
  Generado por la consola de iTier. Instala, en silencio y como servicios:
    - GLPI Agent      : inventario del equipo hacia GLPI (con el tag del cliente)
    - Zabbix Agent 2  : monitoreo, reportando al proxy del appliance de iTier

  Despliegue masivo SIN interaccion (GPO / RMM / Intune, corre como SYSTEM):
      powershell -NoProfile -ExecutionPolicy Bypass -File itier-@@TENANT@@-windows.ps1
  Opciones: -ProxyHost <IP del appliance>  -SinZabbix  -SinGlpi

  No contiene secretos. Deja un registro en %ProgramData%\iTier\instalador.log
#>
param(
  # IP del appliance de iTier en la LAN del cliente (donde corre el zabbix-proxy).
  [string]$ProxyHost = "@@PROXY_IP@@",
  [switch]$SinZabbix,
  [switch]$SinGlpi
)

$ErrorActionPreference = "Stop"
$ProgressPreference = "SilentlyContinue"
[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12

$Tenant     = "@@TENANT@@"
$GlpiServer = "@@GLPI_SERVER@@"
$GlpiMsi    = "@@GLPI_MSI@@"
$ZbxMsi     = "@@ZBX_MSI@@"
$Tmp        = Join-Path $env:TEMP "itier-instalador"
$LogDir     = Join-Path $env:ProgramData "iTier"
New-Item -ItemType Directory -Force -Path $Tmp, $LogDir | Out-Null
$Log        = Join-Path $LogDir "instalador.log"

function Anotar([string]$Texto) {
  $linea = "{0} {1}" -f (Get-Date -Format "s"), $Texto
  Add-Content -Path $Log -Value $linea
  Write-Host "[iTier] $Texto"
}

function Instalar-Msi([string]$Nombre, [string]$Url, [string[]]$Propiedades) {
  $archivo = Join-Path $Tmp ($Nombre + ".msi")
  Anotar "Descargando $Nombre"
  Invoke-WebRequest -Uri $Url -OutFile $archivo -UseBasicParsing
  Anotar "Instalando $Nombre"
  $argumentos = @("/i", "`"$archivo`"", "/qn", "/norestart", "/l*v", "`"$LogDir\$Nombre-msi.log`"") + $Propiedades
  $p = Start-Process -FilePath "msiexec.exe" -ArgumentList $argumentos -Wait -PassThru
  if ($p.ExitCode -ne 0 -and $p.ExitCode -ne 3010) {
    throw "La instalacion de $Nombre fallo (msiexec devolvio $($p.ExitCode))."
  }
}

try {
  Anotar "Inicio - cliente $Tenant - equipo $env:COMPUTERNAME"

  if (-not $SinGlpi) {
    Instalar-Msi "glpi-agent" $GlpiMsi @(
      "SERVER=$GlpiServer",
      "TAG=itier-$Tenant",
      "EXECMODE=1",
      "RUNNOW=1",
      "ADD_FIREWALL_EXCEPTION=1"
    )
  }

  if (-not $SinZabbix) {
    if ([string]::IsNullOrWhiteSpace($ProxyHost)) {
      Anotar "Sin IP del appliance (-ProxyHost): se omite Zabbix Agent."
    } else {
      Instalar-Msi "zabbix-agent2" $ZbxMsi @(
        "SERVER=$ProxyHost",
        "SERVERACTIVE=$ProxyHost",
        "HOSTNAME=$env:COMPUTERNAME",
        "HOSTMETADATA=itier-$Tenant",
        "ENABLEPATH=1"
      )
    }
  }

  Anotar "Listo - equipo enrolado en el cliente $Tenant"
} catch {
  Anotar ("ERROR: " + $_.Exception.Message)
  exit 1
} finally {
  Remove-Item -Recurse -Force $Tmp -ErrorAction SilentlyContinue
}
