#Requires -RunAsAdministrator
<#
  iTier - instalador para equipos Windows del cliente "@@TENANT@@"
  Generado por la consola de iTier. Instala, en silencio y como servicios:
    - GLPI Agent      : inventario del equipo hacia GLPI (con el tag del cliente)
    - Zabbix Agent 2  : monitoreo, reportando al equipo central de iTier

  Hay dos roles (-Rol):
    equipo  (por defecto) GLPI Agent + Zabbix Agent 2. Zabbix reporta al equipo central
            de la LAN (-ProxyHost). No contiene secretos.
    central UN equipo por cliente (idealmente un servidor encendido siempre). Ademas:
            instala cloudflared como tarea de arranque (SYSTEM) que abre el tunel seguro
            a Zabbix (Cloudflare Tunnel + Access) y lo ofrece a la LAN en el puerto 10051,
            y el GLPI Agent tambien contacta el plugin de inventario para el
            descubrimiento/escaneo de la red. CONTIENE EL SERVICE TOKEN: no lo reenvies.

  Despliegue masivo SIN interaccion (GPO / RMM / Intune, corre como SYSTEM):
      powershell -NoProfile -ExecutionPolicy Bypass -File itier-@@TENANT@@-windows.ps1
  Opciones: -ProxyHost <IP del appliance>  -SinZabbix  -SinGlpi

  Al terminar verifica los servicios y la conexion, muestra el resultado y
  avisa a la consola. No contiene secretos. Deja un registro en %ProgramData%\iTier\instalador.log
#>
param(
  # IP del appliance de iTier en la LAN del cliente (donde corre el zabbix-proxy).
  [ValidateSet("equipo", "central")]
  [string]$Rol = "@@ROL@@",
  [string]$ProxyHost = "@@PROXY_IP@@",
  [switch]$SinZabbix,
  [switch]$SinGlpi
)

$ErrorActionPreference = "Stop"
$ProgressPreference = "SilentlyContinue"
[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12

$Tenant     = "@@TENANT@@"
$GlpiServer = "@@GLPI_SERVER@@"
$GlpiMsi    = "@@GLPI_MSI@@"
$ZbxMsi     = "@@ZBX_MSI@@"
$ReportUrl  = "@@URL_REPORTE@@"
$CloudflaredUrl = "@@CLOUDFLARED_URL@@"
$TunelHost  = "@@ZBX_TUNNEL_HOST@@"
$CfId       = "@@CF_ID@@"
$CfSecret   = "@@CF_SECRET@@"
$Tmp        = Join-Path $env:TEMP "itier-instalador"
$LogDir     = Join-Path $env:ProgramData "iTier"
New-Item -ItemType Directory -Force -Path $Tmp, $LogDir | Out-Null
$Log        = Join-Path $LogDir "instalador.log"

function Anotar([string]$Texto) {
  $linea = "{0} {1}" -f (Get-Date -Format "s"), $Texto
  Add-Content -Path $Log -Value $linea
  Write-Host "[iTier] $Texto"
}

function Instalar-Msi([string]$Nombre, [string]$Url, [string[]]$Propiedades) {
  $archivo = Join-Path $Tmp ($Nombre + ".msi")
  Anotar "Descargando $Nombre"
  Invoke-WebRequest -Uri $Url -OutFile $archivo -UseBasicParsing
  Anotar "Instalando $Nombre"
  $argumentos = @("/i", "`"$archivo`"", "/qn", "/norestart", "/l*v", "`"$LogDir\$Nombre-msi.log`"") + $Propiedades
  $p = Start-Process -FilePath "msiexec.exe" -ArgumentList $argumentos -Wait -PassThru
  if ($p.ExitCode -ne 0 -and $p.ExitCode -ne 3010) {
    throw "La instalacion de $Nombre fallo (msiexec devolvio $($p.ExitCode))."
  }
}

function Estado-Servicio([string]$Nombre) {
  $svc = Get-Service -Name $Nombre -ErrorAction SilentlyContinue
  if (-not $svc) { return "ausente" }
  if ($svc.Status -ne "Running") {
    try { Start-Service -Name $Nombre -ErrorAction Stop; Start-Sleep -Seconds 3; $svc.Refresh() } catch { }
  }
  if ($svc.Status -eq "Running") { return "activo" } else { return "detenido" }
}

function Probar-Tcp([string]$Destino, [int]$Puerto) {
  # Distingue "el nombre no existe en DNS" de "no responde el puerto".
  try { [Net.Dns]::GetHostAddresses($Destino) | Out-Null } catch { return "dns_no_resuelve" }
  try {
    $c = New-Object Net.Sockets.TcpClient
    $r = $c.BeginConnect($Destino, $Puerto, $null, $null)
    $ok = $r.AsyncWaitHandle.WaitOne(5000)
    if ($ok) { $c.EndConnect($r) }
    $c.Close()
    if ($ok) { return "ok" } else { return "sin_respuesta" }
  } catch { return "sin_respuesta" }
}

function Probar-Tunel() {
  # De punta a punta: el listener local de cloudflared dialea a Cloudflare Access en
  # cada conexion; si Access la rechaza, la cierra enseguida. Un servidor Zabbix no
  # habla primero, asi que una conexion que sigue abierta indica que paso.
  try { [Net.Dns]::GetHostAddresses($TunelHost) | Out-Null } catch { return "dns_no_resuelve" }
  try {
    $c = New-Object Net.Sockets.TcpClient
    $c.Connect("127.0.0.1", 10051)
    $cerrada = $c.Client.Poll(5000000, [Net.Sockets.SelectMode]::SelectRead)
    $c.Close()
    if ($cerrada) { return "sin_respuesta" } else { return "ok" }
  } catch { return "sin_respuesta" }
}

function Ip-Lan() {
  try {
    $cfg = Get-NetIPConfiguration | Where-Object { $_.IPv4DefaultGateway -and $_.NetAdapter.Status -eq "Up" } | Select-Object -First 1
    return [string]$cfg.IPv4Address.IPAddress
  } catch { return "" }
}

function Linea([string]$Que, [string]$Valor, [bool]$Bien) {
  $marca = "[FALLO]"; $color = "Red"
  if ($Bien) { $marca = "[ OK  ]"; $color = "Green" }
  Write-Host ("  {0} {1,-34} {2}" -f $marca, $Que, $Valor) -ForegroundColor $color
  Add-Content -Path $Log -Value ("  {0} {1}: {2}" -f $marca, $Que, $Valor)
}

$Detalle = ""
try {
  Anotar "Inicio - cliente $Tenant - equipo $env:COMPUTERNAME"

  if (-not $SinGlpi) {
    Instalar-Msi "glpi-agent" $GlpiMsi @(
      "SERVER=$GlpiServer",
      "TAG=itier-$Tenant",
      "EXECMODE=1",
      "RUNNOW=1",
      "ADD_FIREWALL_EXCEPTION=1"
    )
  }

  if (-not $SinZabbix -and -not [string]::IsNullOrWhiteSpace($ProxyHost)) {
    Instalar-Msi "zabbix-agent2" $ZbxMsi @(
      "SERVER=$ProxyHost",
      "SERVERACTIVE=$ProxyHost",
      "HOSTNAME=$env:COMPUTERNAME",
      "HOSTMETADATA=itier-$Tenant",
      "ENABLEPATH=1"
    )
  }
} catch {
  $Detalle = $_.Exception.Message
  Anotar ("ERROR: " + $Detalle)
} finally {
  Remove-Item -Recurse -Force $Tmp -ErrorAction SilentlyContinue
}

# --- Rol central: tunel a Zabbix (cloudflared) + acceso desde la LAN ---------
if ($Rol -eq "central" -and -not $Detalle) {
  try {
    $dirIt = Join-Path $env:ProgramFiles "iTier"
    New-Item -ItemType Directory -Force -Path $dirIt | Out-Null
    $exe = Join-Path $dirIt "cloudflared.exe"
    Stop-ScheduledTask -TaskName "iTier-Tunel" -ErrorAction SilentlyContinue
    Start-Sleep -Seconds 2
    Anotar "Descargando cloudflared"
    Invoke-WebRequest -Uri $CloudflaredUrl -OutFile $exe -UseBasicParsing
    $run = Join-Path $dirIt "tunel.cmd"
    $lineas = @("@echo off",
      "set TUNNEL_SERVICE_TOKEN_ID=$CfId",
      "set TUNNEL_SERVICE_TOKEN_SECRET=$CfSecret",
      "`"$exe`" access tcp --hostname $TunelHost --url 0.0.0.0:10051")
    Set-Content -Path $run -Value $lineas -Encoding ASCII
    # Solo SYSTEM y Administradores (por SID: el nombre depende del idioma).
    & icacls.exe $dirIt /inheritance:r /grant:r "*S-1-5-18:(OI)(CI)F" "*S-1-5-32-544:(OI)(CI)F" | Out-Null
    $accion = New-ScheduledTaskAction -Execute $run
    $disparo = New-ScheduledTaskTrigger -AtStartup
    $ajustes = New-ScheduledTaskSettingsSet -RestartCount 999 -RestartInterval (New-TimeSpan -Minutes 1) -ExecutionTimeLimit ([TimeSpan]::Zero) -StartWhenAvailable -AllowStartIfOnBatteries -DontStopIfGoingOnBatteries
    $quien = New-ScheduledTaskPrincipal -UserId "SYSTEM" -LogonType ServiceAccount -RunLevel Highest
    Register-ScheduledTask -TaskName "iTier-Tunel" -Action $accion -Trigger $disparo -Settings $ajustes -Principal $quien -Force | Out-Null
    Get-NetFirewallRule -DisplayName "iTier - relay Zabbix (10051)" -ErrorAction SilentlyContinue | Remove-NetFirewallRule
    New-NetFirewallRule -DisplayName "iTier - relay Zabbix (10051)" -Direction Inbound -Protocol TCP -LocalPort 10051 -Action Allow -Profile Domain,Private | Out-Null
    Start-ScheduledTask -TaskName "iTier-Tunel"
    Start-Sleep -Seconds 6
    Anotar "Tunel a Zabbix instalado como tarea de arranque (iTier-Tunel)"
  } catch {
    $Detalle = "No se pudo instalar el tunel: " + $_.Exception.Message
    Anotar ("ERROR: " + $Detalle)
  }
}

# Si el agente ya estaba instalado, el MSI no pisa su configuracion: se fija
# el servidor y el tag en el registro y se reinicia el servicio.
if (-not $SinGlpi) {
  try {
    $clave = "HKLM:\SOFTWARE\GLPI-Agent"
    if (Test-Path $clave) {
      Set-ItemProperty -Path $clave -Name "server" -Value $GlpiServer
      Set-ItemProperty -Path $clave -Name "tag" -Value "itier-$Tenant"
      Restart-Service -Name "GLPI-Agent" -ErrorAction SilentlyContinue
    }
  } catch { Anotar ("No se pudo actualizar la configuracion de GLPI Agent: " + $_.Exception.Message) }
}

# --- Verificacion: servicios corriendo y conexion con iTier -----------------
$GlpiSvc = "omitido"; $GlpiCon = "omitido"; $ZbxSvc = "omitido"; $ZbxCon = "omitido"
Write-Host ""
Write-Host "==================== RESULTADO DE LA INSTALACION ====================" -ForegroundColor Cyan
if (-not $SinGlpi) {
  $GlpiSvc = Estado-Servicio "GLPI-Agent"
  $u = [Uri](($GlpiServer -split ",")[0])
  $GlpiCon = Probar-Tcp $u.Host $u.Port
  Linea "Inventario - servicio GLPI Agent" $GlpiSvc ($GlpiSvc -eq "activo")
  Linea "Inventario - conexion al servidor" "$GlpiCon ($($u.Host))" ($GlpiCon -eq "ok")
}
if ($SinZabbix) {
  Write-Host "  [  -  ] Monitoreo: omitido (-SinZabbix)"
} elseif ([string]::IsNullOrWhiteSpace($ProxyHost)) {
  $ZbxSvc = "pendiente"
  Write-Host "  [  -  ] Monitoreo: pendiente (todavia no esta instalado el equipo central de iTier)" -ForegroundColor Yellow
} else {
  $ZbxSvc = Estado-Servicio "Zabbix Agent 2"
  if ($Rol -ne "central") { $ZbxCon = Probar-Tcp $ProxyHost 10051 }
  if ($Rol -eq "central") { $ZbxCon = Probar-Tunel }
  Linea "Monitoreo - servicio Zabbix Agent" $ZbxSvc ($ZbxSvc -eq "activo")
  if ($Rol -eq "central") {
    Linea "Tunel seguro a Zabbix (Cloudflare)" "$ZbxCon ($TunelHost)" ($ZbxCon -eq "ok")
  } else {
    Linea "Monitoreo - conexion al equipo central" "$ZbxCon ($ProxyHost)" ($ZbxCon -eq "ok")
  }
}

$Mal = @($GlpiSvc, $GlpiCon, $ZbxSvc, $ZbxCon) | Where-Object { $_ -in @("ausente", "detenido", "sin_respuesta", "dns_no_resuelve") }
$Estado = "ok"
if ($Detalle -or $Mal) { $Estado = "error" }
if (-not $Detalle -and $GlpiCon -eq "dns_no_resuelve") { $Detalle = "El nombre del servidor de inventario no existe en DNS: $(([Uri]$GlpiServer).Host)" }

# --- Aviso a la consola de iTier (best-effort) ------------------------------
$Avisado = $false
if ($ReportUrl) {
  try {
    $os = (Get-CimInstance Win32_OperatingSystem -ErrorAction SilentlyContinue).Caption
    Invoke-RestMethod -Method Post -Uri $ReportUrl -TimeoutSec 15 -Body @{
      host = $env:COMPUTERNAME; estado = $Estado; os = "$os"
      glpi_servicio = $GlpiSvc; glpi_conexion = $GlpiCon
      zbx_servicio = $ZbxSvc; zbx_conexion = $ZbxCon; detalle = $Detalle; ip = (Ip-Lan)
    } | Out-Null
    $Avisado = $true
  } catch { Anotar ("No se pudo avisar a la consola: " + $_.Exception.Message) }
}

Write-Host "---------------------------------------------------------------------" -ForegroundColor Cyan
if ($Estado -eq "ok") {
  Write-Host "  INSTALACION CORRECTA: el equipo $env:COMPUTERNAME quedo conectado." -ForegroundColor Green
  if ($Avisado) { Write-Host "  Su proveedor de soporte ya fue notificado." -ForegroundColor Green }
} else {
  Write-Host "  LA INSTALACION TUVO PROBLEMAS." -ForegroundColor Red
  if ($Detalle) { Write-Host "  Detalle: $Detalle" -ForegroundColor Red }
  if ($Avisado) { Write-Host "  Su proveedor de soporte ya fue notificado del problema." -ForegroundColor Yellow }
  else { Write-Host "  Avise a su proveedor de soporte y envie el archivo: $Log" -ForegroundColor Yellow }
}
Write-Host "=====================================================================" -ForegroundColor Cyan
Anotar "Fin - estado $Estado"
if ($Estado -ne "ok") { exit 1 }
