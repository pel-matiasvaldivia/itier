# Consola de iTier — copiá a .env y completá. El .env real NO se versiona.

# ── Sesión y acceso ────────────────────────────────────────────────────────
# Clave para firmar las cookies de sesión. OBLIGATORIA. Generala con:
#   openssl rand -hex 32
ITIER_CONSOLE_SECRET=

# Admin inicial: se crea solo en el PRIMER arranque (si no hay usuarios).
# Deberá cambiar la clave y enrolar su 2FA en el primer login.
ITIER_CONSOLE_ADMIN_USER=admin
ITIER_CONSOLE_ADMIN_PASSWORD=

# Cookies seguras (solo HTTPS). Dejalo en 1: la consola va detrás de NPM con TLS.
# Ponelo en 0 SOLO para probar en http://localhost sin TLS.
ITIER_CONSOLE_COOKIE_SECURE=1

# Emisor que se muestra en la app de 2FA.
ITIER_CONSOLE_TOTP_ISSUER=iTier

# Bloqueo por intentos fallidos.
ITIER_CONSOLE_LOCKOUT_THRESHOLD=5
ITIER_CONSOLE_LOCKOUT_WINDOW=900

# ── Publicación (NPM en otro VPS) ──────────────────────────────────────────
# IP de la LAN de este host donde se publica el puerto (para NPM). 0.0.0.0 =
# todas las interfaces (limitá el firewall al VPS de NPM).
WEB_BIND=0.0.0.0
CONSOLE_PORT=8083

# ── Conexión a GLPI ────────────────────────────────────────────────────────
# URL que usa la CONSOLA para llegar a la API de GLPI. Opción A (puertos
# publicados del stack vía host): http://host.docker.internal:8884
# Opción B (red interna del stack): http://glpi
ITIER_GLPI_URL=http://host.docker.internal:8884
ITIER_GLPI_APIREST_PATH=/apirest.php
# Tokens de la API REST de GLPI (Configuración → General → API).
# ⚠ Verificá nombres/flujo contra GLPI 11.
ITIER_GLPI_APP_TOKEN=
ITIER_GLPI_USER_TOKEN=
# URL PÚBLICA de GLPI (la que alcanza el cliente por NPM) para el bundle de
# enrolamiento. Si se omite, se usa ITIER_GLPI_URL.
ITIER_PUBLIC_GLPI_URL=https://itsm.tu-dominio.com

# ── Conexión a Zabbix ──────────────────────────────────────────────────────
# URL de la web/API de Zabbix. Opción A: http://host.docker.internal:8885
# Opción B (red interna): http://zabbix-web:8080
ITIER_ZBX_URL=http://host.docker.internal:8885
# Autenticación: preferí un API token (Zabbix 7.0, Usuarios → Tokens de API).
ITIER_ZBX_TOKEN=
# Alternativa: usuario/clave (se hace user.login).
ITIER_ZBX_USER=
ITIER_ZBX_PASSWORD=
# Dirección pública del servidor Zabbix (host o host:puerto) que marcan los
# proxies de los clientes desde internet. Va en el bundle de enrolamiento.
ITIER_ZBX_SERVER_HOST=tu-vps.tu-dominio.com

# ── Modo demo ──────────────────────────────────────────────────────────────
# 1 = no toca GLPI/Zabbix reales; datos de ejemplo. Para desarrollo local.
# En demo, si no hay admin, se crea admin / itier-demo-admin (NO usar en prod).
# ITIER_CONSOLE_DEMO=1

# ── HTTP ───────────────────────────────────────────────────────────────────
ITIER_CONSOLE_HTTP_TIMEOUT=6
ITIER_LOG_LEVEL=INFO
