# iTier lado del cliente (modo local) — copiá a .env y completá.
# Una instancia por cliente; el .env real NO se versiona.

# ── Identidad y núcleo ────────────────────────────────────────────────────
# Identificador del cliente (tenant). Corto, en minúsculas, sin espacios.
ITIER_TENANT=cliente-demo
# URL pública de GLPI en tu VPS (por Cloudflare Tunnel / NPM, HTTPS). La usan el
# agente y el inventario. Ej: https://itier-itsm.tu-dominio.com
ITIER_GLPI_URL=https://itier-itsm.tu-dominio.com

# ── Imagen del agente ─────────────────────────────────────────────────────
# Publicada por GitHub Actions en GHCR. Fijá un tag/digest verificado para
# despliegues reproducibles (ej: ...itier-agent@sha256:...).
ITIER_AGENT_IMAGE=ghcr.io/pel-matiasvaldivia/itier-agent:latest

# ── Inferencia (definí AL MENOS una) ──────────────────────────────────────
# Producción: gateway del plano de control que custodia la clave y aplica topes.
ITIER_LLM_GATEWAY=
# Modo local Fase 1/2: clave directa de Anthropic. Mantenela fuera de git.
ANTHROPIC_API_KEY=

ITIER_LOG_LEVEL=INFO

# ── Malla WARP de Cloudflare (nodo de red del proxy) ──────────────────────
# Token del NODO de la malla para ESTE cliente. Secreto: sale del panel de
# Cloudflare (Zero Trust → WARP Connector / mesh), uno por cliente. NO va a git.
MESH_NODE_TOKEN=
# Imagen del nodo mesh. Fijá un digest para despliegues reproducibles.
MESH_IMAGE=cloudflare/mesh:latest

# ── Zabbix proxy → servidor del VPS (por la malla) ────────────────────────
# IP PRIVADA del servidor Zabbix DENTRO de la malla de Cloudflare (no es pública;
# no se expone el 10051 a internet). La define tu config de Cloudflare.
ZBX_SERVER_HOST=172.16.0.4
# Cifrado proxy↔server. Recomendado igual sobre la malla (autentica el proxy): psk.
# El bundle que genera la consola ya trae estos tres valores; pegalos tal cual y
# guardá la PSK en ./enc/proxy.psk (el compose ya monta ./enc en /var/lib/zabbix/enc).
#   ZBX_TLSCONNECT=psk
#   ZBX_TLSPSKIDENTITY=itier-cliente-demo
#   ZBX_TLSPSKFILE=/var/lib/zabbix/enc/proxy.psk
ZBX_TLSCONNECT=unencrypted
ZBX_TLSPSKIDENTITY=
ZBX_TLSPSKFILE=

# ── Versiones de imágenes de terceros ─────────────────────────────────────
# El proxy debe ir en la MISMA versión mayor que el server del VPS (7.0 LTS).
ZABBIX_VERSION=alpine-7.0-latest
# ⚠ VERIFICAR imagen y variables de glpi-agent antes de producción.
GLPI_AGENT_IMAGE=glpi/glpi-agent:latest
