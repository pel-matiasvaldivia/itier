# iTiers lado del cliente (modo local) — copiá a .env y completá.
# Una instancia por cliente; el .env real NO se versiona.

# ── Identidad y núcleo ────────────────────────────────────────────────────
# Identificador del cliente (tenant). Corto, en minúsculas, sin espacios.
ITIER_TENANT=cliente-demo
# URL pública de GLPI en tu VPS (por Cloudflare Tunnel / NPM, HTTPS). La usan el
# agente y el inventario. Ej: https://itier-itsm.tu-dominio.com
ITIER_GLPI_URL=https://itier-itsm.tu-dominio.com

# ── Imagen del agente ─────────────────────────────────────────────────────
# Publicada por GitHub Actions en GHCR. Fijá un tag/digest verificado para
# despliegues reproducibles (ej: ...itier-agent@sha256:...).
ITIER_AGENT_IMAGE=ghcr.io/pel-matiasvaldivia/itier-agent:latest

# ── Inferencia (definí AL MENOS una) ──────────────────────────────────────
# Producción: gateway del plano de control que custodia la clave y aplica topes.
ITIER_LLM_GATEWAY=
# Modo local Fase 1/2: clave directa de Anthropic. Mantenela fuera de git.
ANTHROPIC_API_KEY=

ITIER_LOG_LEVEL=INFO

# ── Túnel al servidor Zabbix del VPS (Cloudflare Access) ──────────────────
# Hostname del servidor Zabbix publicado por el Cloudflare Tunnel del VPS (TCP),
# y el service token de Cloudflare Access que lo autoriza. Los tres valores son
# COMUNES a todos los clientes y los pone el instalador de la consola. Secretos.
ZBX_TUNNEL_HOSTNAME=itier-zbx.tu-dominio.com
CF_ACCESS_CLIENT_ID=reemplazar.access
CF_ACCESS_CLIENT_SECRET=reemplazar-por-el-secreto-del-service-token
CLOUDFLARED_IMAGE=cloudflare/cloudflared:latest

# ── Zabbix proxy ──────────────────────────────────────────────────────────
# Cifrado proxy↔server (PSK propia de cada cliente; la genera la consola).
#   ZBX_TLSCONNECT=psk
#   ZBX_TLSPSKIDENTITY=itier-cliente-demo
#   ZBX_TLSPSKFILE=/var/lib/zabbix/enc/proxy.psk
# Puerto de la LAN donde el proxy escucha a los agentes Zabbix de los equipos.
ZBX_PROXY_PORT=10051
ZBX_TLSCONNECT=unencrypted
ZBX_TLSPSKIDENTITY=
ZBX_TLSPSKFILE=

# ── GLPI Agent — descubrimiento de red (SNMP) + inventario ────────────────
# Imagen propia publicada en GHCR (no hay imagen oficial del agente). Fijá un
# digest para builds reproducibles.
GLPI_AGENT_IMAGE=ghcr.io/pel-matiasvaldivia/itier-glpi-agent:latest
# Endpoint del plugin GlpiInventory (GLPI 11). Si lo dejás vacío, se deriva de
# ITIER_GLPI_URL (la raíz de GLPI: inventario nativo de GLPI 10+).
ITIER_GLPI_INVENTORY_URL=
# Tareas del agente y retardo inicial (segundos). Normalmente no hace falta tocar.
GLPI_AGENT_TASKS=inventory,netdiscovery,netinventory
GLPI_AGENT_DELAYTIME=60
# Opciones extra del agente (una sola cadena). Ej.: afinar SNMP si hiciera falta.
GLPI_AGENT_EXTRA=
# IMPORTANTE: los RANGOS de IP a barrer y las CREDENCIALES SNMP NO van acá; se
# definen una vez por cliente en el server (GLPI → GlpiInventory). Ver README.

# ── Versiones de imágenes de terceros ─────────────────────────────────────
# El proxy debe ir en la MISMA versión mayor que el server del VPS (7.0 LTS).
ZABBIX_VERSION=alpine-7.0-latest
