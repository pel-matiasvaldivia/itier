# iTier VPS (Fase 1 y 2) — copiá este archivo a .env y completá los valores.
# El .env real NO se versiona (ver .gitignore). Generá contraseñas robustas, p.ej.:
#   openssl rand -base64 24
# Evitá el carácter comilla simple ( ' ) en las contraseñas: se interpolan en SQL.

# ── PostgreSQL (motor de Zabbix) ──────────────────────────────────────────
# POSTGRES_* es el superusuario de Postgres; lo usa el init de Zabbix. GLPI NO
# usa Postgres (ver MariaDB abajo). Dejá estos valores: la base ya está creada.
POSTGRES_DB=glpi
POSTGRES_USER=glpi
POSTGRES_PASSWORD=cambiame-glpi
# El rol/base 'zabbix' los crea deploy/vps/init/10-init-zabbix.sh en el primer
# arranque de Postgres, con esta contraseña.
ZABBIX_DB_PASSWORD=cambiame-zabbix

# ── MariaDB (motor de GLPI) ───────────────────────────────────────────────
# GLPI 11 requiere MySQL 8.0+ / MariaDB 10.6+ (NO Postgres). La imagen oficial
# glpi/glpi usa estas variables; con las 5 presentes hace la auto-instalación.
GLPI_DB_NAME=glpi
GLPI_DB_USER=glpi
GLPI_DB_PASSWORD=cambiame-glpi-mariadb
GLPI_DB_ROOT_PASSWORD=cambiame-root-mariadb

# ── Imágenes ──────────────────────────────────────────────────────────────
# GLPI 11 (oficial). Fijá idealmente por digest una versión verificada.
GLPI_IMAGE=glpi/glpi:11.0
# MariaDB para GLPI (10.6+; 11.4 es LTS).
GLPI_DB_IMAGE=mariadb:11.4
# Zabbix 7.0 LTS sobre PostgreSQL.
ZABBIX_VERSION=alpine-7.0-latest
# Imagen de la consola, construida en CI y publicada en GHCR (el VPS NO compila).
# `:latest` se publica solo desde la rama default; mientras trabajes en la rama
# claude/… pineá el tag de esa rama (o un digest/sha). Ej.:
#   CONSOLE_IMAGE=ghcr.io/pel-matiasvaldivia/itier-console:claude-agentic-ai-itsm-tipcii
CONSOLE_IMAGE=ghcr.io/pel-matiasvaldivia/itier-console:latest

# ── Frontends web (detrás de Cloudflare Tunnel en ESTE host) ──────────────
# A dónde se atan los puertos web del stack. Con cloudflared corriendo en el
# propio VPS, atalos a LOOPBACK: así solo el túnel los alcanza y NADA queda
# expuesto en la red ni en internet. El ingress de Cloudflare apunta a
# http://localhost:<puerto> (ver deploy/vps/README.md → "Detrás de Cloudflare").
#   127.0.0.1  → recomendado con cloudflared en el host.
#   IP-LAN     → si en cambio usás NPM en otro VPS de la LAN.
#   0.0.0.0    → solo si el firewall ya limita el acceso.
WEB_BIND=127.0.0.1
# Puertos publicados en el host para cada frontend (destino del ingress).
GLPI_HTTP_PORT=8884
ZBX_WEB_PORT=8885

# ── Servidor Zabbix (puerto de proxies remotos) ───────────────────────────
# Bind de 10051/tcp. A diferencia de la web, este es PÚBLICO: los zabbix-proxy
# de los clientes se conectan por internet. Dejalo en 0.0.0.0 y limitá el origen
# en el firewall a las IP de tus clientes (y usá PSK/TLS).
ZBX_SERVER_BIND=0.0.0.0

# ── Consola de operación (plano de control) ───────────────────────────────
# Clave para firmar las sesiones de la consola. OBLIGATORIA, REEMPLAZAR por una
# aleatoria: openssl rand -hex 32
ITIER_CONSOLE_SECRET=cambiame-con-openssl-rand-hex-32
# Admin inicial de la consola (se crea en el primer arranque; cambia clave y
# enrola 2FA en el primer login).
ITIER_CONSOLE_ADMIN_USER=admin
ITIER_CONSOLE_ADMIN_PASSWORD=cambiame-consola
# Puerto de la consola (destino del ingress de Cloudflare: http://localhost:8083).
# Hostname público sugerido: itier-panel.pymesenlinea.com.ar  (un solo nivel de
# subdominio: así lo cubre el certificado gratis de Cloudflare — ver README).
CONSOLE_PORT=8083
#
# Tokens de la API REST de GLPI. Se generan DENTRO de GLPI (ver README):
#   Configuración → General → API (habilitar) y cliente de API → App token.
#   Preferencias del usuario de servicio → token de API personal → User token.
ITIER_GLPI_APP_TOKEN=
ITIER_GLPI_USER_TOKEN=
# URL PÚBLICA de GLPI (la que alcanza el cliente), para el bundle de enrolamiento.
# Con Cloudflare, el hostname de GLPI por el túnel (un nivel, cubierto por el cert
# gratis), ej. itier-itsm.pymesenlinea.com.ar.
ITIER_PUBLIC_GLPI_URL=https://itier-itsm.pymesenlinea.com.ar
#
# Token de API de Zabbix (7.0: Usuarios → Tokens de API). Alternativa: usuario/clave.
ITIER_ZBX_TOKEN=
# ITIER_ZBX_USER=
# ITIER_ZBX_PASSWORD=
# Dirección del servidor Zabbix (host o host:puerto) que marcan los proxies de
# los clientes. Va en el bundle de enrolamiento. ⚠ El 10051 es TCP crudo y NO
# pasa por el Cloudflare Tunnel (que es HTTP): usá una dirección ALCANZABLE
# directo — IP pública del VPS o una VPN (ver README). No el hostname de Cloudflare.
ITIER_ZBX_SERVER_HOST=tu-vps-ip-o-vpn
#
# La consola llega a GLPI/Zabbix por la red INTERNA; estos valores ya vienen por
# defecto y normalmente no hace falta tocarlos:
#   ITIER_GLPI_URL=http://glpi
#   ITIER_ZBX_URL=http://zabbix-web:8080

# ── Zona horaria ──────────────────────────────────────────────────────────
TZ=America/Argentina/Buenos_Aires
