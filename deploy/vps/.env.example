# iTier VPS (Fase 1 y 2) — copiá este archivo a .env y completá los valores.
# El .env real NO se versiona (ver .gitignore). Generá contraseñas robustas, p.ej.:
#   openssl rand -base64 24
# Evitá el carácter comilla simple ( ' ) en las contraseñas: se interpolan en SQL.

# ── PostgreSQL (motor de Zabbix) ──────────────────────────────────────────
# POSTGRES_* es el superusuario de Postgres; lo usa el init de Zabbix. GLPI NO
# usa Postgres (ver MariaDB abajo). Dejá estos valores: la base ya está creada.
POSTGRES_DB=glpi
POSTGRES_USER=glpi
POSTGRES_PASSWORD=cambiame-glpi
# El rol/base 'zabbix' los crea deploy/vps/init/10-init-zabbix.sh en el primer
# arranque de Postgres, con esta contraseña.
ZABBIX_DB_PASSWORD=cambiame-zabbix

# ── MariaDB (motor de GLPI) ───────────────────────────────────────────────
# GLPI 11 requiere MySQL 8.0+ / MariaDB 10.6+ (NO Postgres). La imagen oficial
# glpi/glpi usa estas variables; con las 5 presentes hace la auto-instalación.
GLPI_DB_NAME=glpi
GLPI_DB_USER=glpi
GLPI_DB_PASSWORD=cambiame-glpi-mariadb
GLPI_DB_ROOT_PASSWORD=cambiame-root-mariadb

# ── Imágenes ──────────────────────────────────────────────────────────────
# GLPI 11 (oficial). Fijá idealmente por digest una versión verificada.
GLPI_IMAGE=glpi/glpi:11.0
# MariaDB para GLPI (10.6+; 11.4 es LTS).
GLPI_DB_IMAGE=mariadb:11.4
# Zabbix 7.0 LTS sobre PostgreSQL.
ZABBIX_VERSION=alpine-7.0-latest
# Imagen de la consola, construida en CI y publicada en GHCR (el VPS NO compila).
# `:latest` se publica solo desde la rama default; mientras trabajes en la rama
# claude/… pineá el tag de esa rama (o un digest/sha). Ej.:
#   CONSOLE_IMAGE=ghcr.io/pel-matiasvaldivia/itier-console:claude-agentic-ai-itsm-tipcii
CONSOLE_IMAGE=ghcr.io/pel-matiasvaldivia/itier-console:latest

# ── Frontends web (detrás de Cloudflare Tunnel en ESTE host) ──────────────
# A dónde se atan los puertos web del stack. Con cloudflared corriendo en el
# propio VPS, atalos a LOOPBACK: así solo el túnel los alcanza y NADA queda
# expuesto en la red ni en internet. El ingress de Cloudflare apunta a
# http://localhost:<puerto> (ver deploy/vps/README.md → "Detrás de Cloudflare").
#   127.0.0.1  → recomendado con cloudflared en el host.
#   IP-LAN     → si en cambio usás NPM en otro VPS de la LAN.
#   0.0.0.0    → solo si el firewall ya limita el acceso.
WEB_BIND=127.0.0.1
# Puertos publicados en el host para cada frontend (destino del ingress).
GLPI_HTTP_PORT=8884
ZBX_WEB_PORT=8885

# ── Servidor Zabbix (puerto de proxies remotos) ───────────────────────────
# Bind de 10051/tcp. A diferencia de la web, este es PÚBLICO: los zabbix-proxy
# de los clientes se conectan por internet. Dejalo en 0.0.0.0 y limitá el origen
# en el firewall a las IP de tus clientes (y usá PSK/TLS).
ZBX_SERVER_BIND=127.0.0.1

# ── Consola de operación (plano de control) ───────────────────────────────
# Clave para firmar las sesiones de la consola. OBLIGATORIA, REEMPLAZAR por una
# aleatoria: openssl rand -hex 32
ITIER_CONSOLE_SECRET=cambiame-con-openssl-rand-hex-32
# Admin inicial de la consola (se crea en el primer arranque; cambia clave y
# enrola 2FA en el primer login).
ITIER_CONSOLE_ADMIN_USER=admin
ITIER_CONSOLE_ADMIN_PASSWORD=cambiame-consola
# Puerto de la consola (destino del ingress de Cloudflare: http://localhost:8083).
# Hostname público sugerido: itier-panel.pymesenlinea.com.ar  (un solo nivel de
# subdominio: así lo cubre el certificado gratis de Cloudflare — ver README).
CONSOLE_PORT=8083
#
# Tokens de la API REST de GLPI. Se generan DENTRO de GLPI (ver README):
#   Configuración → General → API (habilitar) y cliente de API → App token.
#   Preferencias del usuario de servicio → token de API personal → User token.
ITIER_GLPI_APP_TOKEN=
ITIER_GLPI_USER_TOKEN=
# URL PÚBLICA de GLPI (la que alcanza el cliente), para el bundle de enrolamiento.
# Con Cloudflare, el hostname de GLPI por el túnel (un nivel, cubierto por el cert
# gratis), ej. itier-itsm.pymesenlinea.com.ar.
ITIER_PUBLIC_GLPI_URL=https://itier-itsm.pymesenlinea.com.ar
#
# Token de API de Zabbix (7.0: Usuarios → Tokens de API). Alternativa: usuario/clave.
ITIER_ZBX_TOKEN=
# ITIER_ZBX_USER=
# ITIER_ZBX_PASSWORD=
# Dirección del servidor Zabbix (host o host:puerto) que marcan los proxies de
# los clientes. Va en el bundle de enrolamiento. ⚠ El 10051 es TCP crudo y NO
# pasa por el Cloudflare Tunnel (que es HTTP). Recomendado: la IP PRIVADA del VPS
# dentro de la malla WARP de Cloudflare (p. ej. 172.16.0.4), así no se expone el
# 10051 a internet (ver ADR-0009). Alternativa: IP pública con firewall acotado.
ITIER_ZBX_SERVER_HOST=172.16.0.4
#
# URL PÚBLICA de la consola (la que alcanza el equipo del cliente). Con ella se
# arma el comando de instalación del appliance. Ej: https://itier-consola.tu-dominio.com
ITIER_CONSOLE_PUBLIC_URL=
# (Opcional) MSI de Zabbix Agent 2 para el instalador de equipos Windows. Fijá
# una versión que exista en cdn.zabbix.com, de la misma mayor que el server.
ITIER_ZBX_AGENT_MSI_URL=
#
# La consola llega a GLPI/Zabbix por la red INTERNA; estos valores ya vienen por
# defecto y normalmente no hace falta tocarlos:
#   ITIER_GLPI_URL=http://glpi
#   ITIER_ZBX_URL=http://zabbix-web:8080

# ── Zona horaria ──────────────────────────────────────────────────────────
TZ=America/Argentina/Buenos_Aires

# ── Túnel a Zabbix para los clientes (ADR-0010) ───────────────────────────
# El server Zabbix se publica como hostname TCP en el Cloudflare Tunnel de este
# VPS, protegido por Cloudflare Access. Estos tres valores son COMUNES a todos
# los clientes: la consola los incluye en cada instalador. SECRETOS: solo acá.
#   Hostname de UN nivel (cubierto por el cert gratis), ej. itier-zbx.tu-dominio.com
ITIER_ZBX_TUNNEL_HOSTNAME=
#   Service token: Zero Trust → Access → Service Auth → Create Service Token.
ITIER_CF_ACCESS_CLIENT_ID=
ITIER_CF_ACCESS_CLIENT_SECRET=
# SMTP (opcional) para enviarle al cliente el enlace del instalador de Windows.
# Sin esto, la consola genera el enlace y lo mandás desde tu correo.
ITIER_SMTP_HOST=
ITIER_SMTP_PORT=587
ITIER_SMTP_USER=
ITIER_SMTP_PASSWORD=
ITIER_SMTP_FROM=
ITIER_SMTP_TLS=starttls

# ── Soporte remoto: MeshCentral (ADR-0011) ──────────────────────────────────
# Hostname público (un solo nivel) publicado en el túnel → http://localhost:MESH_PORT
MESH_HOSTNAME=itier-mesh.pymesenlinea.com.ar
MESH_PORT=8886
# Imagen publicada por GitHub Actions (build-meshcentral.yml). En una rama de trabajo usá su tag:
# MESHCENTRAL_IMAGE=ghcr.io/pel-matiasvaldivia/itier-meshcentral:claude-agentic-ai-itsm-tipcii
# true SOLO el primer día para crear tu cuenta de administrador; después false.
MESH_NEW_ACCOUNTS=false
# La consola crea un grupo de equipos por cliente con una cuenta de servicio
# (sin 2FA: la API por contraseña no admite TOTP).
ITIER_MESH_URL=https://itier-mesh.pymesenlinea.com.ar
ITIER_MESH_USER=itier-api
ITIER_MESH_PASSWORD=
# Grupo de usuarios de Mesh con los técnicos de soporte: la consola le da acceso a cada
# grupo de cliente que crea (control remoto, terminal, archivos). Los técnicos son
# usuarios de Mesh miembros de este grupo.
ITIER_MESH_SUPPORT_GROUP=SOPORTE
# Alerta de disco: % de uso a partir del cual se avisa (por unidad).
ITIER_ALERTA_DISCO_PCT=90
# Rendimiento: segundos que se reusan sesiones y lecturas de GLPI/Zabbix entre pantallas (0 = sin caché).
ITIER_ADAPTER_CACHE_S=60
# Grupo de usuarios de Zabbix de los técnicos/PM (se crea solo si no existe).
ITIER_ZBX_SOPORTE_GROUP=iTier Soporte
# Opcional: la URL pública de Zabbix aparece en el correo de bienvenida.
# ITIER_ZBX_PUBLIC_URL=https://itier-zabbix.pymesenlinea.com.ar
# Quién puede EMBEBER Mesh en la consola (conexión remota dentro del panel). Por defecto, la URL de la consola.
# MESH_FRAME_ORIGINS=https://itierconsole.pymesenlinea.com.ar

# ── Canales de entrada: los clientes piden soporte por correo y WhatsApp ───────
# Casilla de soporte (se muestra en la consola). Los correos que lleguen a este buzón abren
# tickets del cliente cuyo dominio (o persona) esté cargado en su ficha.
ITIER_SOPORTE_EMAIL=soporte@pymesenlinea.com.ar
# Buzón IMAP que la consola lee cada ITIER_IMAP_POLL_S segundos (vacío = canal de correo apagado).
# Gmail/Workspace: usá una «contraseña de aplicación». Los leídos se marcan como vistos.
ITIER_IMAP_HOST=
ITIER_IMAP_PORT=993
ITIER_IMAP_USER=
ITIER_IMAP_PASSWORD=
ITIER_IMAP_FOLDER=INBOX
ITIER_IMAP_TLS=ssl
ITIER_IMAP_POLL_S=60
# Microsoft 365 / buzón compartido: ITIER_IMAP_AUTH=oauth2_ms + tenant, ID de aplicación y secreto (mejor cargarlos desde Canales en la consola).
ITIER_IMAP_AUTH=password
# ITIER_IMAP_MS_TENANT=
# ITIER_IMAP_MS_CLIENT_ID=
# ITIER_IMAP_MS_SECRET=
# WhatsApp (OpenWA, forma parte del stack; ITIER_WA_HOOK_TOKEN e ITIER_WA_API_KEY son OBLIGATORIAS): secreto de la URL del webhook /hooks/whatsapp/<token> → openssl rand -hex 24
ITIER_WA_HOOK_TOKEN=cambiame-con-openssl-rand-hex-24
# Para que la consola confirme al cliente por WhatsApp (opcional): API de OpenWA y su clave.
ITIER_WA_API_KEY=cambiame-con-openssl-rand-hex-24
# La consola le contesta al cliente por esta API (ya apunta al servicio openwa del stack).
# ITIER_WA_API_URL=http://openwa:8080
# Imagen de OpenWA (la construye GitHub Actions desde deploy/openwa).
# OPENWA_IMAGE=ghcr.io/pel-matiasvaldivia/itier-openwa:latest
# Número de soporte, solo para mostrarlo en la consola (ej. 5491155551234).
# ITIER_WA_NUMERO=
# Mensajes por remitente y hora antes de frenarlo (anti-inundación).
ITIER_CANAL_LIMITE_HORA=20

# ── Reporte de horas y rentabilidad (pantalla Horas, solo administrador) ───────
# Valores iniciales; se editan en la consola. Cotización de referencia (pesos por USD) y costo fijo mensual de la plataforma.
# ITIER_FX_ARS_USD=
ITIER_COSTO_PLATAFORMA_USD=60

# ── Microsoft 365: gestión de usuarios del tenant de cada cliente ─────────────
# Opcional: se cargan desde la consola (Clientes → ficha → «Configurar la aplicación de Microsoft 365»). Si los definís acá
# son los valores iniciales. Ver deploy/vps/README.md → «Microsoft 365».
# ITIER_M365_CLIENT_ID=
# ITIER_M365_CLIENT_SECRET=

# ── Google Workspace: gestión de usuarios del dominio de cada cliente ─────────
# Se carga desde la consola (Clientes → ficha → «Configurar la cuenta de servicio de Google»), cifrada. Ver deploy/vps/README.md.
# ITIER_GWS_SA_JSON=
