# iTier VPS (Fase 1 y 2) — copiá este archivo a .env y completá los valores.
# El .env real NO se versiona (ver .gitignore). Generá contraseñas robustas, p.ej.:
#   openssl rand -base64 24
# Evitá el carácter comilla simple ( ' ) en las contraseñas: se interpolan en SQL.

# ── PostgreSQL / GLPI ─────────────────────────────────────────────────────
POSTGRES_DB=glpi
POSTGRES_USER=glpi
POSTGRES_PASSWORD=cambiame-glpi

# ── PostgreSQL / Zabbix ───────────────────────────────────────────────────
# El rol/base 'zabbix' los crea deploy/vps/init/10-init-zabbix.sh en el
# primer arranque, con esta contraseña.
ZABBIX_DB_PASSWORD=cambiame-zabbix

# ── Imágenes ──────────────────────────────────────────────────────────────
# GLPI 11 es reciente: fijá aquí la imagen (idealmente por digest) que hayas
# verificado. Confirmá que soporte PostgreSQL y sus nombres de variables.
GLPI_IMAGE=glpi/glpi:11.0
# Zabbix 7.0 LTS sobre PostgreSQL.
ZABBIX_VERSION=alpine-7.0-latest

# ── Frontends web (NPM está en otro VPS de la LAN) ────────────────────────
# IP de la LAN de ESTE VPS donde se publican los puertos web, para que NPM (en
# el otro VPS) los alcance. Recomendado: poné la IP privada de este VPS (ej.
# 10.0.0.5) para NO exponer las UIs a internet. 0.0.0.0 las publica en todas las
# interfaces: usalo solo si el firewall limita el acceso al VPS de NPM.
WEB_BIND=0.0.0.0
# Puertos publicados en el host para cada frontend (NPM apunta a IP-LAN:puerto).
GLPI_HTTP_PORT=8884
ZBX_WEB_PORT=8885

# ── Servidor Zabbix (puerto de proxies remotos) ───────────────────────────
# Bind de 10051/tcp. A diferencia de la web, este es PÚBLICO: los zabbix-proxy
# de los clientes se conectan por internet. Dejalo en 0.0.0.0 y limitá el origen
# en el firewall a las IP de tus clientes (y usá PSK/TLS).
ZBX_SERVER_BIND=0.0.0.0

# ── Zona horaria ──────────────────────────────────────────────────────────
TZ=America/Argentina/Buenos_Aires
